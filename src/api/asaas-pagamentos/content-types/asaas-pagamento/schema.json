{
  "kind": "collectionType",
  "collectionName": "asaas_pagamentos",
  "info": {
    "singularName": "asaas-pagamento",
    "pluralName": "asaas-pagamentos",
    "displayName": "Asaas Pagamento"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "asaas_payment_id": {
      "type": "text",
      "required": true,
      "unique": true
    },
    "asaas_subscription_id": {
      "type": "text",
      "required": true
    },
    "user_id_login": {
      "type": "text",
      "required": true
    },
    "valor": {
      "type": "decimal",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["PENDING", "RECEIVED", "OVERDUE", "CANCELLED"],
      "required": true
    },
    "tipo_cobranca": {
      "type": "enumeration",
      "enum": ["PIX", "BOLETO", "CREDIT_CARD"],
      "required": true
    },
    "data_vencimento": {
      "type": "date",
      "required": true
    },
    "data_pagamento": {
      "type": "datetime",
      "required": false
    },
    "url_pagamento": {
      "type": "text",
      "required": false
    },
    "criado_em": {
      "type": "datetime",
      "required": true
    }
  }
}
